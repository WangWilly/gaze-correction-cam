<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- System Extension Installation -->
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    
    <!-- App Sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    
    <!-- Camera Access -->
    <key>com.apple.security.device.camera</key>
    <true/>
    
    <!-- User Selected Files (for settings import/export) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- App Groups (for sharing settings between app and extension) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.gazecorrection.camera</string>
    </array>
    
    <!-- Network Access (for potential future backend communication) -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
